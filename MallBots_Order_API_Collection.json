            }
          }
        },
        {
          "name": "Complete Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{invoiceId}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/ordering/orders/{{orderId}}/complete",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "ordering", "orders", "{{orderId}}", "complete"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/ordering/orders/{{orderId}}/cancel",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "ordering", "orders", "{{orderId}}", "cancel"]
            }
          }
        }
      ]
