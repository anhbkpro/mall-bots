{
  "info": {
    "name": "MallBots Order API Collection",
    "_postman_id": "mallbots-order-api-collection",
    "description": "Complete MallBots API collection for testing order operations with all related data setup",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup Data",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"smsNumber\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/customers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "customers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('customerId', response.id);",
                  "    console.log('Customer ID set:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tech Store\",\n  \"location\": \"San Francisco, CA\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/stores",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "stores"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('storeId', response.id);",
                  "    console.log('Store ID set:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Enable Store Participation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/stores/{{storeId}}/enable-participation",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "stores", "{{storeId}}", "enable-participation"]
            }
          }
        },
        {
          "name": "Add Product to Store",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"description\": \"Latest iPhone model\",\n  \"sku\": \"IPHONE-15-128GB\",\n  \"price\": 999.99\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/stores/{{storeId}}/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "stores", "{{storeId}}", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('productId', response.id);",
                  "    console.log('Product ID set:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Authorize Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"amount\": 999.99\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/payments/authorize",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "payments", "authorize"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
