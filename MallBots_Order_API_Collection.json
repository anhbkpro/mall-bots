              { "key": "accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"storeId\": \"{{storeId}}\",\n      \"productId\": \"{{productId}}\",\n      \"storeName\": \"Tech Store\",\n      \"productName\": \"iPhone 15\",\n      \"price\": 999.99,\n      \"quantity\": 1\n    }\n  ],\n  \"customerId\": \"{{customerId}}\",\n  \"paymentId\": \"{{paymentId}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/ordering/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "ordering", "orders"]
